    "textBlockQuote.border": "#22C55E",
    "textCodeBlock.background": "#000000",
    "button.background": "#22C55E",
    "button.foreground": "#000000",
    "button.hoverBackground": "#66FF66",
    "button.secondaryBackground": "#262626",
    "button.secondaryForeground": "#F5F7FA",
    "button.secondaryHoverBackground": "#404040",
    "dropdown.background": "#1A1A1A",
    "dropdown.border": "#404040",
    "dropdown.foreground": "#F5F7FA",
    "input.background": "#000000",
    "input.border": "#404040",
    "input.foreground": "#F5F7FA",
    "input.placeholderForeground": "#666666",
    "inputOption.activeBackground": "#22C55E30",
    "inputOption.activeBorder": "#22C55E",
    "badge.background": "#22C55E",
    "badge.foreground": "#000000",
    "progressBar.background": "#22C55E",
    "list.activeSelectionBackground": "#22C55E28",
    "list.activeSelectionForeground": "#F5F7FA",
    "list.inactiveSelectionBackground": "#262626",
    "list.hoverBackground": "#1A1A1A",
    "list.focusOutline": "#22C55E",
    "list.highlightForeground": "#66FF66",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#F5F7FA",
    "activityBar.inactiveForeground": "#666666",
    "activityBar.activeBorder": "#22C55E",
    "activityBarBadge.background": "#22C55E",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#121416",
    "sideBar.foreground": "#C9D1D9",
    "sideBar.border": "#262626",
    "sideBarTitle.foreground": "#F5F7FA",
    "sideBarSectionHeader.background": "#1A1A1A",
    "sideBarSectionHeader.foreground": "#F5F7FA",
    "sideBarSectionHeader.border": "#262626",
    "editorGroupHeader.tabsBackground": "#121416",
    "editorGroupHeader.tabsBorder": "#262626",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#F5F7FA",
    "tab.activeBorderTop": "#22C55E",
    "tab.inactiveBackground": "#121416",
    "tab.inactiveForeground": "#9CA3AF",
    "tab.border": "#262626",
    "editor.background": "#000000",
    "editor.foreground": "#C9D1D9",
    "editorLineNumber.foreground": "#404040",
    "editorLineNumber.activeForeground": "#9CA3AF",
    "editorCursor.foreground": "#66FF66",
    "editor.selectionBackground": "#22C55E38",
    "editor.inactiveSelectionBackground": "#22C55E20",
    "editor.lineHighlightBackground": "#121416",
    "editor.findMatchBackground": "#FBBF2460",
    "editor.findMatchHighlightBackground": "#FBBF2430",
    "editor.wordHighlightBackground": "#60A5FA22",
    "editor.wordHighlightStrongBackground": "#60A5FA35",
    "editorWhitespace.foreground": "#262626",
    "editorIndentGuide.background1": "#1A1A1A",
    "editorIndentGuide.activeBackground1": "#404040",
    "editorBracketMatch.background": "#22C55E25",
    "editorBracketMatch.border": "#22C55E",
    "editorGutter.addedBackground": "#22C55E",
    "editorGutter.modifiedBackground": "#60A5FA",
    "editorGutter.deletedBackground": "#EF4444",
    "editorError.foreground": "#EF4444",
    "editorWarning.foreground": "#FBBF24",
    "editorInfo.foreground": "#60A5FA",
    "editorHint.foreground": "#22C55E",
    "editorWidget.background": "#121416",
    "editorWidget.border": "#404040",
    "editorSuggestWidget.background": "#121416",
    "editorSuggestWidget.border": "#404040",
    "editorSuggestWidget.selectedBackground": "#22C55E28",
    "peekView.border": "#22C55E",
    "peekViewEditor.background": "#000000",
    "peekViewResult.background": "#121416",
    "peekViewResult.selectionBackground": "#22C55E28",
    "panel.background": "#000000",
    "panel.border": "#262626",
    "panelTitle.activeBorder": "#22C55E",
    "panelTitle.activeForeground": "#F5F7FA",
    "panelTitle.inactiveForeground": "#666666",
    "terminal.background": "#000000",
    "terminal.foreground": "#C9D1D9",
    "terminalCursor.foreground": "#66FF66",
    "terminal.ansiBlack": "#121416",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#22C55E",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#60A5FA",
    "terminal.ansiMagenta": "#A78BFA",
    "terminal.ansiCyan": "#22C5B5",
    "terminal.ansiWhite": "#C9D1D9",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#FF6B6B",
    "terminal.ansiBrightGreen": "#66FF66",
    "terminal.ansiBrightYellow": "#FDE68A",
    "terminal.ansiBrightBlue": "#93C5FD",
    "terminal.ansiBrightMagenta": "#C4B5FD",
    "terminal.ansiBrightCyan": "#5EEAD4",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "statusBar.background": "#121416",
    "statusBar.foreground": "#C9D1D9",
    "statusBar.border": "#262626",
    "statusBar.debuggingBackground": "#FBBF24",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.prominentBackground": "#22C55E",
    "statusBarItem.prominentForeground": "#000000",
    "titleBar.activeBackground": "#121416",
    "titleBar.activeForeground": "#F5F7FA",
    "titleBar.inactiveBackground": "#121416",
    "titleBar.inactiveForeground": "#666666",
    "titleBar.border": "#262626",
    "menu.background": "#121416",
    "menu.foreground": "#F5F7FA",
    "menu.selectionBackground": "#22C55E28",
    "menu.selectionForeground": "#F5F7FA",
    "menu.separatorBackground": "#404040",
    "notificationCenterHeader.background": "#1A1A1A",
    "notifications.background": "#121416",
    "notifications.border": "#404040",
    "gitDecoration.addedResourceForeground": "#66FF66",
    "gitDecoration.modifiedResourceForeground": "#60A5FA",
    "gitDecoration.deletedResourceForeground": "#EF4444",
    "gitDecoration.renamedResourceForeground": "#22C5B5",
    "gitDecoration.untrackedResourceForeground": "#22C55E",
    "gitDecoration.ignoredResourceForeground": "#666666",
    "charts.green": "#22C55E",
    "charts.blue": "#60A5FA",
    "charts.yellow": "#FBBF24",
    "charts.red": "#EF4444",
    "charts.purple": "#A78BFA",
    "charts.orange": "#F59E0B"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#666666", "fontStyle": "italic"}
    },
    {
      "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": {"foreground": "#86EFAC"}
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {"foreground": "#FDE68A"}
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {"foreground": "#A78BFA"}
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {"foreground": "#60A5FA"}
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {"foreground": "#5EEAD4"}
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": {"foreground": "#C9D1D9"}
    },
    {
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {"foreground": "#F5F7FA"}
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {"foreground": "#22C55E"}
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {"foreground": "#93C5FD"}
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {"foreground": "#FFFFFF", "background": "#EF4444"}
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {"foreground": "#66FF66", "fontStyle": "bold"}
    },
    {
      "scope": ["markup.inserted"],
      "settings": {"foreground": "#66FF66"}
    },
    {
      "scope": ["markup.deleted"],
      "settings": {"foreground": "#FF6B6B"}
    },
    {
      "scope": ["markup.changed"],
      "settings": {"foreground": "#93C5FD"}
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5EEAD4",
    "type": "#5EEAD4",
    "class": "#5EEAD4",
    "enum": "#5EEAD4",
    "interface": "#5EEAD4",
    "struct": "#5EEAD4",
    "typeParameter": "#93C5FD",
    "function": "#60A5FA",
    "method": "#60A5FA",
    "property": "#C9D1D9",
    "variable": "#C9D1D9",
    "parameter": "#F5F7FA",
    "enumMember": "#FDE68A",
    "keyword": "#A78BFA",
    "string": "#86EFAC",
    "number": "#FDE68A",
    "comment": {"foreground": "#666666", "italic": true}
  }
}
