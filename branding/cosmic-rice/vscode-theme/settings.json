{
  "workbench.colorTheme": "LuigiOS Workstation",
  "workbench.preferredDarkColorTheme": "LuigiOS Workstation",
  "workbench.iconTheme": "luigios-icons",
  "window.autoDetectColorScheme": false,
  "window.titleBarStyle": "custom",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveIndentation": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.15,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.list.smoothScrolling": true,
  "workbench.reduceMotion": "off"
}
