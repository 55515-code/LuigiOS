[Icon Theme]
Name=LuigiOS
Comment=Professional LuigiOS workstation icon layer
Inherits=Papirus-Dark,Cosmic,hicolor
Example=folder
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,24,32,48,64,128
ToolbarDefault=24
ToolbarSizes=16,24,32
MainToolbarDefault=24
MainToolbarSizes=16,24,32
SmallDefault=16
SmallSizes=16,24,32
PanelDefault=32
PanelSizes=16,24,32,48,64
DialogDefault=48
DialogSizes=16,24,32,48,64,128
Directories=scalable/apps,scalable/places,scalable/status,symbolic/apps

[scalable/apps]
Context=Applications
Size=64
Type=Scalable
MinSize=16
MaxSize=512

[scalable/places]
Context=Places
Size=64
Type=Scalable
MinSize=16
MaxSize=512

[scalable/status]
Context=Status
Size=24
Type=Scalable
MinSize=16
MaxSize=64

[symbolic/apps]
Context=Applications
Size=16
Type=Scalable
MinSize=16
MaxSize=64
