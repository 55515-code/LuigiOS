#!/usr/bin/env bash
set -euo pipefail

target=${1:?target root is required}
[[ -d "${target}/etc" ]] || {
    echo "invalid target root: ${target}" >&2
    exit 1
}

rsync -aHAX --exclude=/target-root \
    /usr/share/luigios/ "${target}/usr/share/luigios/"
rsync -aHAX /usr/share/luigios/target-root/ "${target}/"

# Archiso normalizes most airootfs payload modes. Reinstall executable target
# helpers explicitly instead of trusting the transport mode from SquashFS.
install -Dm0755 \
    /usr/share/luigios/target-root/usr/lib/luigios/cosmic-greeter-start \
    "${target}/usr/lib/luigios/cosmic-greeter-start"
install -Dm0755 \
    /usr/lib/luigios/refresh-cosmic-panel \
    "${target}/usr/lib/luigios/refresh-cosmic-panel"

install -m 0644 /usr/share/luigios/pacman.conf "${target}/etc/pacman.conf"
install -m 0644 /usr/share/luigios/os-release "${target}/usr/lib/os-release"
ln -sfn ../usr/lib/os-release "${target}/etc/os-release"

# limine-entry-tool deliberately refuses to copy the live environment's kernel
# command line while running in Calamares' chroot. Seed the installed system's
# real root identity before generating its boot entries.
root_uuid=$(findmnt -n -o UUID --target "${target}")
root_fstype=$(findmnt -n -o FSTYPE --target "${target}")
root_fsroot=$(findmnt -n -o FSROOT --target "${target}")
[[ -n "${root_uuid}" ]] || {
    echo "could not determine target root UUID" >&2
    exit 1
}
kernel_cmdline="root=UUID=${root_uuid} rw quiet splash"
if [[ "${root_fstype}" == btrfs && "${root_fsroot}" != / ]]; then
    kernel_cmdline+=" rootflags=subvol=${root_fsroot#/}"
fi
install -d "${target}/etc/kernel"
printf '%s\n' "${kernel_cmdline}" >"${target}/etc/kernel/cmdline"

ln -sfn /usr/lib/systemd/system/cosmic-greeter.service \
    "${target}/etc/systemd/system/display-manager.service"
install -d "${target}/etc/systemd/system/multi-user.target.wants"
ln -sfn /usr/lib/systemd/system/luigios-firstboot.service \
    "${target}/etc/systemd/system/multi-user.target.wants/luigios-firstboot.service"
install -d "${target}/etc/systemd/system/system-update.target.wants"
ln -sfn /usr/lib/systemd/system/luigios-offline-update.service \
    "${target}/etc/systemd/system/system-update.target.wants/luigios-offline-update.service"
install -d "${target}/etc/systemd/user/graphical-session-pre.target.wants"
ln -sfn /usr/lib/systemd/user/luigios-first-login.service \
    "${target}/etc/systemd/user/graphical-session-pre.target.wants/luigios-first-login.service"
install -d "${target}/etc/systemd/user/graphical-session.target.wants"
ln -sfn /usr/lib/systemd/user/luigios-panel-refresh.service \
    "${target}/etc/systemd/user/graphical-session.target.wants/luigios-panel-refresh.service"

rm -f "${target}/etc/systemd/system/multi-user.target.wants/sshd.service"
rm -f "${target}/etc/systemd/system/multi-user.target.wants/systemd-networkd.service"
rm -f "${target}/etc/systemd/system/sockets.target.wants/systemd-networkd.socket"
rm -f "${target}/etc/systemd/system/multi-user.target.wants/wpa_supplicant.service"
