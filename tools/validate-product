#!/usr/bin/env python3
"""Validate the workstation product boundary without contacting the network."""

from __future__ import annotations

import json
import fnmatch
import pathlib
import stat
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
errors: list[str] = []


def error(message: str) -> None:
    errors.append(message)


for relative in (
    "product/cachyos/product.json",
    "product/cachyos/services.json",
    "profiles/workstation-v1.json",
    "sdk/package-lock.json",
):
    try:
        json.loads((ROOT / relative).read_text())
    except Exception as exc:
        error(f"{relative}: {exc}")

product = json.loads((ROOT / "product/cachyos/product.json").read_text())
if product["version"] != (ROOT / "VERSION").read_text().strip():
    error("VERSION and product version differ")
if product["desktop"].get("session") != "cosmic":
    error("COSMIC must be the product session")
if not product["desktop"].get("exclusive"):
    error("desktop exclusivity must be explicit")

roots = [
    line.split("#", 1)[0].strip()
    for line in (ROOT / "product/cachyos/packages.x86_64").read_text().splitlines()
    if line.split("#", 1)[0].strip()
]
forbidden = [
    line.strip().lower()
    for line in (ROOT / "product/cachyos/forbidden-packages.txt").read_text().splitlines()
    if line.strip() and not line.startswith("#")
]
for package in roots:
    if any(
        fnmatch.fnmatchcase(package.lower(), pattern)
        for pattern in forbidden
    ):
        error(f"forbidden package root: {package}")

for relative in (
    "branding/cosmic-rice/apply-user.sh",
    "branding/cosmic-rice/apply-system.sh",
    "tools/sdk",
    "tools/package-lock",
    "tools/inspect-image",
):
    path = ROOT / relative
    if not path.is_file():
        error(f"missing executable: {relative}")
    elif not path.stat().st_mode & stat.S_IXUSR:
        error(f"not executable: {relative}")

legacy_trees = ("prototype", "product/package", "product/patches", "third_party/bua")
for relative in legacy_trees:
    path = ROOT / relative
    if path.exists() and any(item.is_file() for item in path.rglob("*")):
        error(f"legacy implementation remains: {relative}")

legacy_terms = (
    "batocera",
    "steam deck",
    "gamescope",
    "retroarch",
    "emulationstation",
    "fedora atomic",
    "bootc",
)
scan_exclusions = {
    ROOT / "LICENSE",
    ROOT / "product/cachyos/forbidden-packages.txt",
    ROOT / "tools/validate-product",
    ROOT / "tools/sdk",
    ROOT / "tools/inspect-image",
}
tracked = subprocess.run(
    ["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard"],
    check=True,
    text=True,
    capture_output=True,
).stdout.splitlines()
for relative in tracked:
    path = ROOT / relative
    if (
        not path.is_file()
        or path in scan_exclusions
    ):
        continue
    try:
        text = path.read_text().lower()
    except UnicodeDecodeError:
        continue
    for term in legacy_terms:
        if term in text:
            error(f"legacy term {term!r} remains in {path.relative_to(ROOT)}")

if errors:
    print("\n".join(f"error: {message}" for message in errors), file=sys.stderr)
    raise SystemExit(1)
print(f"valid LuigiOS workstation product: {len(roots)} package roots")
