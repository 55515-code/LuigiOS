#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
image=${1:-}
if [[ -z "${image}" ]]; then
    mapfile -t images < <(
        find "${ROOT}/dist" -maxdepth 1 -type f -name 'luigios-*.iso' -print |
            sort
    )
    [[ ${#images[@]} -eq 1 ]] || {
        echo "expected exactly one LuigiOS ISO in ${ROOT}/dist; pass a path explicitly" >&2
        exit 1
    }
    image=${images[0]}
fi
[[ -f "${image}" ]] || {
    echo "ISO not found: ${image}" >&2
    exit 1
}

metadata=$(xorriso -indev "${image}" -pvd_info 2>&1)
grep -Eiq "Volume (id|Id) +: '?LUIGIOS_" <<<"${metadata}" || {
    echo "ISO volume ID is not LuigiOS" >&2
    exit 1
}

listing=$(
    xorriso -indev "${image}" -find / -type f -exec echo 2>/dev/null |
        sed "s/^'//; s/'$//"
)
for required in \
    /arch/x86_64/airootfs.sfs \
    /loader/loader.conf \
    /loader/entries/01-luigios-lts.conf \
    /loader/entries/02-luigios-performance.conf \
    /loader/entries/03-luigios-safe-graphics.conf
do
    grep -Fxq "${required}" <<<"${listing}" || {
        echo "required ISO payload missing: ${required}" >&2
        exit 1
    }
done

if grep -Eiq 'batocera|steam|gamescope|retroarch|emulationstation|plasma|sddm' \
    <<<"${listing}"; then
    echo "legacy or alternate-desktop path found in ISO" >&2
    exit 1
fi

# Verify Cromite desktop entry is present in the ISO.
grep -q 'io.github.cromite.cromite.desktop' <<<"${listing}" || {
    echo "Cromite desktop entry is missing from the ISO" >&2
    exit 1
}

# Verify the Cromite binary is included in the squashfs payload.
if command -v unsquashfs >/dev/null 2>&1; then
    workdir=$(mktemp -d)
    trap 'rm -rf "${workdir}"' EXIT
    unsquashfs -d "${workdir}" -e "usr/bin/cromite" "${image}"
    [[ -f "${workdir}/usr/bin/cromite" ]] || {
        echo "Cromite binary is missing from the live squashfs" >&2
        exit 1
    }
else
    echo "warning: unsquashfs not available; Cromite binary not verified inside squashfs" >&2
fi

# Validate source-level Cromite configuration.
"${ROOT}/tools/validate-cromite" >/dev/null

checksum="${image}.sha256"
(
    cd -- "$(dirname -- "${image}")"
    sha256sum "$(basename -- "${image}")"
) >"${checksum}.tmp"
mv "${checksum}.tmp" "${checksum}"
printf 'verified ISO: %s\nchecksum: %s\n' "${image}" "${checksum}"
