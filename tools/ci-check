#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "${root}"

python -m unittest discover -s tests -v
./tools/package-lock validate
./tools/validate-product
./tools/validate-cromite

# Run automation suite checks
python tools/polish/design-tokens-validate
python tools/polish/asset-optimize
python tools/qa/accessibility-check
python tools/polish/brand-consistency
python tools/research/upstream-tracker

bash -n tools/sdk
bash -n branding/cosmic-rice/apply-user.sh
bash -n branding/cosmic-rice/apply-system.sh
bash -n product/cachyos/overlay/usr/lib/luigios/firstboot
python -m py_compile tools/package-lock tools/check-dco tools/release-source \
    tools/update-credits tools/recovery-sim \
    tools/build-aur tools/validate-cromite \
    tools/qa/recovery-btrfs-vm \
    tools/qa/qmp \
    tools/polish/design-tokens-validate \
    tools/polish/asset-optimize \
    tools/polish/brand-consistency \
    tools/qa/accessibility-check \
    tools/qa/release-readiness \
    tools/research/upstream-tracker \
    product/cachyos/overlay/usr/lib/luigios/recovery_engine.py
bash -n tools/qa/run-recovery-btrfs-vm
./tools/recovery-sim >/dev/null

git diff --check
git diff --cached --check
